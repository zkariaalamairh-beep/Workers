@model IReadOnlyList<ProviderCardViewModel>

@section Styles {
    <link rel="stylesheet"
          href="~/css/pages/providers.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/components/provider-card.css"
          asp-append-version="true" />
}

@{
    ViewData["Title"] = "مقدمو الخدمات";

    string selectedKind =
        Context.Request.Query["kind"].ToString();

    string search =
        Context.Request.Query["search"].ToString();
}

<section class="page-hero">
    <div>
        <h1>مقدمو الخدمات</h1>

        <p>
            ابحث عن المهني أو عامل اليومية المناسب،
            وشاهد الخدمات والخبرة والتقييمات.
        </p>
    </div>

    <button type="button"
            class="btn hero-location-button js-nearby-providers">
        ⌖ اعرض الأقرب إليّ
    </button>
</section>

<form method="get"
      asp-controller="Providers"
      asp-action="Index"
      class="filter-panel">

    <div class="row g-3">
        <div class="col-lg-7">
            <label class="form-label" for="search">
                ابحث بالاسم أو الخدمة
            </label>

            <input id="search"
                   name="search"
                   value="@search"
                   class="form-control"
                   placeholder="مثال: كهربائي، سباك، دهان..." />
        </div>

        <div class="col-lg-3">
            <label class="form-label" for="kind">
                نوع مقدم الخدمة
            </label>

            <select id="kind"
                    name="kind"
                    class="form-select">

                <option value="">
                    جميع الأنواع
                </option>

                <option value="1"
                        selected="@(selectedKind == "1")">
                    مهنيون
                </option>

                <option value="2"
                        selected="@(selectedKind == "2")">
                    عمال يومية
                </option>
            </select>
        </div>

        <div class="col-lg-2 d-flex align-items-end gap-2">
            <button type="submit"
                    class="btn btn-primary flex-grow-1">
                بحث
            </button>

            <a asp-controller="Providers"
               asp-action="Index"
               class="btn btn-outline-secondary">
                مسح
            </a>
        </div>
    </div>
</form>

<div class="results-heading">
    <h2>نتائج البحث</h2>

    <span class="results-count">
        @Model.Count مقدم خدمة
    </span>
</div>

@if (Model.Count > 0)
{
    <div class="provider-grid">
        @foreach (ProviderCardViewModel provider in Model)
        {
            <partial name="_ProviderCard"
                     model="provider" />
        }
    </div>
}
else
{
    <div class="empty-state">
        <span class="empty-state-icon">🔍</span>

        <h3>لا توجد نتائج</h3>

        <p>
            جرّب تغيير كلمة البحث أو نوع مقدم الخدمة.
        </p>

        <a asp-controller="Providers"
           asp-action="Index"
           class="btn btn-primary">
            عرض جميع مقدمي الخدمات
        </a>
    </div>
}